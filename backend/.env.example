# PostgreSQL v14+ per SRS section 2.4 Operating Environment.
# Supabase needs TWO different connection strings - see README "Changes
# from the SRS" and DEPLOYMENT.md for exactly where to copy these from.
#
# DATABASE_URL - the pooled "Transaction mode" string (port 6543, ?pgbouncer=true).
#   Used by the running app. Required so many connections can be opened at once.
# DIRECT_URL   - the "Session mode" / direct string (port 5432).
#   Used only by the Prisma CLI for migrations. Prisma reads this
#   automatically via `directUrl` in schema.prisma - the pooled connection
#   alone makes `prisma migrate` hang or fail.
#
# For local dev without Supabase: postgresql://USER:PASSWORD@localhost:5432/peerlink
#   (in that case DATABASE_URL and DIRECT_URL can be identical)
DATABASE_URL="postgresql://postgres.xxxxxxxx:[password]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Institutional email domain enforced at registration (SRS 5.5 Business Rules)
INSTITUTIONAL_EMAIL_DOMAIN="alueducation.com"

# Email via Resend (SRS 3.3 Software Interfaces) - real integration, not stubbed.
# Sign up free at https://resend.com, verify a sending domain (or use their
# shared test domain for a demo), and create an API key.
# Without RESEND_API_KEY set, emails are logged to the console instead of
# sent - registration/reset still work, the link is just handed back in
# the API response rather than emailed.
RESEND_API_KEY=""
EMAIL_FROM="PeerLink <onboarding@resend.dev>"

FRONTEND_URL="http://localhost:5173"
